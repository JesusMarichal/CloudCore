# --- Paddle (frontend) -------------------------------------------------------
# Solo las variables con prefijo VITE_ llegan al bundle del navegador.
# Nunca pongas aquí la API key de servidor (API_PADDLE): esa vive en el .env raíz.

# Client-side token de Paddle. Es público por diseño.
# Sandbox: empieza por `test_`.  Producción: empieza por `live_`.
# Se saca de Paddle > Developer tools > Authentication.
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Entorno de Paddle: `sandbox` o `production`.
# Sin valor por defecto: si falta o es inválido, la página de precios falla
# en voz alta en vez de arriesgarse a hablar con la cuenta equivocada.
VITE_PADDLE_ENV=sandbox
