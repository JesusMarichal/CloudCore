# Plantilla de variables de entorno del backend.
#
# Este fichero SÍ se versiona: solo debe contener placeholders o valores de
# desarrollo local. Cópialo a `.env` (que está en .gitignore) y rellena ahí los
# valores reales. Los marcados como (opcional) pueden quedarse vacíos para una
# instalación local de demostración.

# --- Base de datos (PostgreSQL) ---
# Por defecto apunta al Postgres de docker-compose.yml (`npm run db:up`).
# Para Neon/Supabase: pon su host/usuario/password y DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudcore
DB_USER=cloudcore
DB_PASSWORD=cloudcore
DB_SSL=false

# --- Autenticación ---
# Cadena larga y aleatoria. Cambiarla invalida todas las sesiones abiertas.
# Genera una con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h

# --- Cifrado de credenciales SSH ---
# Cifra contraseñas y claves privadas de los servidores. OBLIGATORIA: sin ella
# el backend falla al guardar o leer servidores. Genera una con: openssl rand -hex 16
ENCRYPTION_KEY=

# Orígenes permitidos por CORS, separados por comas.
FRONTEND_ORIGIN=http://localhost:5173

# --- Correo SMTP (opcional) ---
# Si se dejan vacías, los códigos de verificación y los enlaces de
# restablecimiento de contraseña se imprimen en la consola del backend.
# Para Gmail hace falta una "contraseña de aplicación", no la del correo.
EMAIL_USER=
EMAIL_PASS=

# --- GitHub (opcional) ---
# Secreto de firma de los webhooks de GitHub (auto-deploy).
GITHUB_WEBHOOK_SECRET=

# --- Paddle (opcional: solo para la página de precios y la facturación) ---
# API key de servidor (Paddle > Developer tools > Authentication). En sandbox
# empieza por pdl_sdbx_. Nunca la expongas al frontend.
API_PADDLE=

# Entorno de Paddle: sandbox | production. Debe cuadrar con el prefijo de la key.
PADDLE_ENV=sandbox

# Secreto de firma del destino de notificaciones (webhooks). No es la API key.
PADDLE_WEBHOOK_SECRET=

# Allowlist de IPs de Paddle para el endpoint de webhooks.
# Sin valor: activa solo cuando PADDLE_ENV=production.
# PADDLE_IP_ALLOWLIST=true

# --- Frontend (Vite) ---
# Públicas por diseño: acaban en el bundle. En sandbox el token empieza por test_.
# `npm run build:all` las copia a frontend/.env.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# --- TLS ---
# Ponlo en `true` SOLO cuando haya HTTPS delante (Nginx con certificado).
HTTPS_ENABLED=false
