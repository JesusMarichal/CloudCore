# Plantilla de variables de entorno del backend.
#
# Este fichero SÍ se versiona: solo debe contener placeholders.
# Copialo a `.env` y rellena ahí los valores reales. `.env` está en .gitignore.

# --- Neon (base de datos activa) ---
DB_HOST=ep-tu-endpoint-pooler.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=tu_password_de_neon
DB_SSL=true

# Host directo (sin pooler), por si se necesita para migraciones:
NEON_DIRECT_HOST=ep-tu-endpoint.region.aws.neon.tech

# --- Correo SMTP (envío de correo) ---
# Para Gmail hace falta una "contraseña de aplicación", no la del correo.
EMAIL_USER=tu-cuenta@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# --- Autenticación ---
# Cadena larga y aleatoria. Cambiarla invalida todas las sesiones abiertas.
JWT_SECRET=cadena_aleatoria_larga
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS, separados por comas.
FRONTEND_ORIGIN=http://localhost:5173

# --- GitHub ---
# Secreto de firma de los webhooks de GitHub.
GITHUB_WEBHOOK_SECRET=tu_secreto_de_webhook

# --- Paddle (backend) ---
# API key de servidor (Paddle > Developer tools > Authentication).
# Nunca la expongas al frontend: solo las variables VITE_ llegan al navegador.
API_PADDLE=pdl_sdbx_xxxxxxxxxxxxxxxxxxxxxxxx

# Entorno de Paddle: sandbox | production. Sin valor por defecto en el código:
# si falta o no cuadra con el prefijo de la key, la app falla al arrancar.
PADDLE_ENV=sandbox

# Secreto de firma del destino de notificaciones (webhooks).
# Uno por destino: NO es la API key y no se comparte entre sandbox y producción.
# Se lee al crear el destino en Paddle > Developer tools > Notifications.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxx

# Allowlist de IPs de Paddle para el endpoint de webhooks.
# Sin valor: activa solo cuando PADDLE_ENV=production. Se desactiva en sandbox
# porque el desarrollo local pasa por tuneles y la IP de origen es la del tunel.
# La lista se descarga de {sandbox-,}api.paddle.com/ips; nunca se hardcodea.
# PADDLE_IP_ALLOWLIST=true
